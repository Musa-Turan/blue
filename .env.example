# Copy this file to .env and fill in your actual credentials.
# DO NOT COMMIT .env TO VERSION CONTROL.

# --- Database Connections ---
OPENSEARCH_HOST=192.168.1.38
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_opensearch_password_here

# --- Wazuh API (Tenant: Default) ---
WAZUH_MANAGER_IP=192.168.1.38
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your_wazuh_password_here

# --- Dummy EDR API (Tenant: Secondary) ---
DUMMY_EDR_API_KEY=your_dummy_key_here
DUMMY_EDR_HOST=api.dummy-edr.local
